{
  "name": "@laioutr/app-vtex",
  "version": "0.1.0",
  "description": "Laioutr integration with VTEX",
  "repository": "github:laioutr/app-vtex",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "npm run dev:prepare && nuxi dev playground --dotenv ../.env",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "test": "vitest run",
    "types:vtex": "openapi-typescript https://developers.vtex.com/api/openapi/catalog-api -o src/runtime/server/types/vtexCatalogTypes.d.ts",
    "test:types": "vue-tsc --noEmit && vue-tsc -p src/runtime/server/tsconfig.json --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@nuxt/kit": "3.16.2",
    "@screeny05/ts-money": "^1.2.0",
    "zod": "3.25.61"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@laioutr-app/ui": "^2.8.2",
    "@laioutr-core/devtools": "^0.37.1",
    "@laioutr/eslint-config": "^1.8.8",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@types/node": "latest",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "nuxt": "3.16.2",
    "openapi-typescript": "^7.13.0",
    "pinia": "3.0.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.26.2",
    "@laioutr-core/core-types": ">=0.37.1",
    "@laioutr-core/frontend-core": ">=0.37.1",
    "@laioutr-core/kit": ">=0.37.1",
    "@laioutr-core/orchestr": ">=0.37.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  }
}
